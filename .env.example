# Chatbot (serveur uniquement — ne pas préfixer par NEXT_PUBLIC_)
GEMINI_API_KEY=

# Contact — compte Gmail + mot de passe d’application
EMAIL_USER=
EMAIL_PASS=

# Optionnel : destinataire des messages (défaut dans le code si vide)
# CONTACT_TO_EMAIL=

# Optionnel : rate limiting /api/chatbot en prod serverless (Upstash Redis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
